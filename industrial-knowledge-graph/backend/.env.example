# ══════════════════════════════════════════════════════════
# Industrial Knowledge Graph — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════

# ── Database (MySQL) ────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/industrial_kg
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=industrial_kg
MYSQL_USER=root
MYSQL_PASSWORD=root

# ── Neo4j (optional — currently using MySQL-backed graph) ───
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ── AI APIs (set at least one) ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── Security ────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── File Uploads ────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
